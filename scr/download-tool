    # ==================== Cookie 管理相关 ====================
    def get_cookie_for_url(self, url):
        """根据 URL 返回匹配的 cookie 文件路径，若无匹配返回 None"""
        try:
            parsed = urlparse(url)
            hostname = parsed.hostname or ""
            if not hostname:
                return None
            # 去除可能的 www. 前缀以获得更宽松匹配
            hostname_lower = hostname.lower()
            # 获取所有已保存的 cookie 域名文件
            if not os.path.exists(self.cookies_storage_dir):
                return None
            best_match = None
            best_len = 0
            for filename in os.listdir(self.cookies_storage_dir):
                if filename.endswith(".txt"):
                    domain = filename[:-4].lower()
                    # 匹配：如果 hostname 以 domain 结尾（且 domain 前为 '.' 或 完全相等）
                    # 或者 domain 是 hostname 的后缀（例如 bilibili.com 匹配 www.bilibili.com）
                    if hostname_lower == domain or hostname_lower.endswith("." + domain) or hostname_lower.endswith(domain):
                        # 选取最长匹配（更精确）
                        if len(domain) > best_len:
                            best_len = len(domain)
                            best_match = os.path.join(self.cookies_storage_dir, filename)
            return best_match
        except Exception:
            return None

    def filter_headers_for_url(self, header_text, url):
        """根据目标 URL 智能过滤自定义请求头。

        匹配规则：
        - 若请求头的值中包含 URL 或裸域名（如 https://music.163.com/ 或 music.163.com），
          则仅当目标 URL 的主机名与该域名匹配（相等或以 .域名 结尾）时才应用。
        - 若请求头的值中不含域名（如 User-Agent、Accept 等），则视为全局请求头，
          应用于所有 URL。
        """
        parsed = urlparse(url)
        hostname = (parsed.hostname or "").lower()

        result = []
        if not header_text:
            return result

        for line in header_text.splitlines():
            line = line.strip()
            if not line or ":" not in line:
                continue

            key, _, value = line.partition(":")
            value = value.strip()

            header_domain = None

            # 情形一：值是 URL，如 https://music.163.com/ 或 //music.163.com/
            url_match = re.match(r'^(?:https?:)?//([^/\s:]+)', value, re.I)
            if url_match:
                header_domain = url_match.group(1).lower()
            else:
                # 情形二：值本身就是裸域名，如 music.163.com
                if re.fullmatch(r'[a-z0-9-]+(?:\.[a-z0-9-]+)+', value, re.I):
                    header_domain = value.lower()

            if header_domain:
                # 仅在主机名匹配时才应用
                if hostname == header_domain or hostname.endswith("." + header_domain):
                    result.append(line)
                    self.log(f"请求头域名匹配 [{header_domain}] -> 注入: {line}")
                else:
                    self.log(f"请求头域名不匹配 [{header_domain}] -> 跳过: {line}")
            else:
                # 无域名，视为全局请求头
                result.append(line)

        return result

