        self.resize(760, 640)
        self.setModal(True)

        # 去掉标题栏 X，并禁用 ESC 关闭
        self.setWindowFlags(
            (self.windowFlags() | Qt.WindowTitleHint | Qt.WindowSystemMenuHint)
            & ~Qt.WindowCloseButtonHint
        )

        self._agreed = False
        self._no_ask_again = False
        self._has_reached_bottom = False
        self._load_thread = None

        self._init_ui()

        # 启动后立刻发起网络请求
