# ============================================================
# Cookie 一键下载工作线程
# ============================================================
class CookieDownloadWorker(QThread):
    log_signal = pyqtSignal(str)
    finished_signal = pyqtSignal(bool, str)

    def __init__(self, domain, output_dir, parent=None):
        super().__init__(parent)
        self.domain = domain
        self.output_dir = output_dir

    def run(self):
        try:
            self.log_signal.emit("正在检查/安装 browser_cookie3 ...")
            subprocess.run(
                [sys.executable, "-m", "pip", "install", "browser_cookie3"],
                capture_output=True, check=True
            )

            import browser_cookie3

            self.log_signal.emit(f"正在从默认浏览器提取 {self.domain} 的 cookies ...")

            cookiejar = None
            browser_names = ["chrome", "firefox", "opera", "edge", "chromium", "brave"]
            for browser_name in browser_names:
                try:
                    load_func = getattr(browser_cookie3, browser_name, None)
                    if load_func is None:
                        continue
                    cookiejar = load_func(domain_name=self.domain)
                    if cookiejar and len(cookiejar) > 0:
                        self.log_signal.emit(f"成功从 {browser_name} 浏览器提取到 {len(cookiejar)} 个 cookies")
                        break
                except Exception:
                    continue

            if cookiejar is None or len(cookiejar) == 0:
                self.finished_signal.emit(False, f"未能从浏览器中提取到 {self.domain} 的 cookies。\n请确保您已在浏览器中登录该平台。")
                return

            os.makedirs(self.output_dir, exist_ok=True)
            output_path = os.path.join(self.output_dir, "cookies.txt")

            with open(output_path, "w", encoding="utf-8") as f:
                f.write("# Netscape HTTP Cookie File\n")
                f.write("# This file was generated by You-Get/YT-DLP Batch Download Tool\n")
                f.write("# \n")
                for cookie in cookiejar:
                    domain = cookie.domain if cookie.domain else self.domain
                    flag = "TRUE" if domain.startswith(".") else "FALSE"
                    path = cookie.path if cookie.path else "/"
                    secure = "TRUE" if cookie.secure else "FALSE"
                    expires = str(int(cookie.expires)) if cookie.expires else "0"
                    name = cookie.name if cookie.name else ""
                    value = cookie.value if cookie.value else ""
                    f.write(f"{domain}\t{flag}\t{path}\t{secure}\t{expires}\t{name}\t{value}\n")

            self.log_signal.emit(f"Cookies 已导出到: {output_path}")
            self.finished_signal.emit(True, output_path)

        except subprocess.CalledProcessError as e:
            self.finished_signal.emit(False, f"安装 browser_cookie3 失败: {e.stderr.decode() if e.stderr else str(e)}")
        except Exception as e:
            self.finished_signal.emit(False, f"导出 cookies 失败: {str(e)}")


# ============================================================
# 协议加载线程（在线请求）
# ============================================================
class AgreementLoadThread(QThread):
    """在后台线程请求在线协议内容，避免阻塞 UI。"""
    finished_signal = pyqtSignal(bool, str)  # (成功?, 内容或错误信息)

    def __init__(self, url, parent=None):
        super().__init__(parent)
        self.url = url

    def run(self):
        try:
            req = urllib.request.Request(
                self.url,
                headers={
                    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                                  "DownloadTool/1.0"
                }
            )
            with urllib.request.urlopen(req, timeout=10) as resp:
                html = resp.read().decode("utf-8", errors="replace")
            self.finished_signal.emit(True, html)
        except Exception as e:
            self.finished_signal.emit(False, str(e))


