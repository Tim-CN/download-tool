    def browse_log_dir(self):
        path = QFileDialog.getExistingDirectory(self, "选择日志保存目录")
        if path:
            self.log_dir_edit.setText(path)

    def open_log_dir(self):
        path = self.log_dir_edit.text().strip()
        if path:
            os.startfile(path)

    def move_log_dir(self):
        """将现有日志目录下的所有内容移动到新目录"""
        old_dir = self.log_dir_edit.text().strip()
        if not old_dir or not os.path.exists(old_dir):
            QMessageBox.warning(self, "警告", "当前日志目录不存在或为空。")
            return

        new_parent_dir = QFileDialog.getExistingDirectory(self, "选择新的日志目录位置")
        if not new_parent_dir:
            return

        if os.path.normpath(old_dir) == os.path.normpath(new_parent_dir):
            QMessageBox.information(self, "提示", "新目录与当前目录相同，无需移动。")
            return

        reply = QMessageBox.question(
            self, "确认移动",
            f"确定要将当前日志目录下的所有文件移动到：\n{new_parent_dir}\n吗？",
            QMessageBox.Yes | QMessageBox.No
        )
        if reply != QMessageBox.Yes:
            return

        try:
            for item in os.listdir(old_dir):
                src = os.path.join(old_dir, item)
                dst = os.path.join(new_parent_dir, item)
                if os.path.exists(dst):
                    continue
                shutil.move(src, dst)

            # ===== 修复：主动持久化新路径 =====
            self.log_dir_edit.setText(new_parent_dir)
            self.settings.setValue("log_dir", new_parent_dir)  # 写入硬盘
            if self.parent_widget:
                self.parent_widget.on_settings_changed()       # 通知主窗口刷新 self.log_dir
            # ===================================

            QMessageBox.information(self, "成功", f"日志文件已成功移动至：\n{new_parent_dir}")
        except Exception as e:
            QMessageBox.critical(self, "错误", f"移动失败：{e}")


