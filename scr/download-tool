    # ==================== 下载控制 ====================
    def stop_download(self):
        self.stop_flag = True
        for proc in self.processes:
            if proc.state() != QProcess.NotRunning:
                proc.kill()
        self.url_queue.clear()
        self.processes.clear()
        self.task_running = False
        self.start_btn.setEnabled(self.is_current_tool_available())
        self.stop_btn.setEnabled(False)
        self.log("用户停止了下载任务。")

    def start_download(self):
        if not self.is_current_tool_available():
            QMessageBox.warning(self, "缺少下载引擎", f"请先安装 {self.current_tool} 后再下载！\n点击「设置」查看安装帮助。")
            return

        out_dir = self.dir_edit.text().strip()
        if not out_dir or not os.path.isdir(out_dir):
            QMessageBox.warning(self, "警告", "下载目录无效，请重新选择。")
            return

        raw_text = self.url_edit.toPlainText()
        urls = []
        for line in raw_text.splitlines():
            line = line.strip()
            if line and line not in urls:
                urls.append(line)

        if not urls:
            QMessageBox.warning(self, "警告", "URL 列表为空，请添加下载链接。")
            return

        self.url_queue = urls[:]
        self.total_tasks = len(urls)
        self.success_count = 0
        self.fail_count = 0
        self.stop_flag = False
        self.max_parallel = self.parallel_spin.value() if self.parallel_check.isChecked() else 1

        self.log(f"开始批量下载，共 {self.total_tasks} 个任务，最大并行数 {self.max_parallel}")
        self.log(f"下载目录: {out_dir}")
        self.log(f"使用下载引擎: {self.current_tool}")

        self.start_btn.setEnabled(False)
        self.stop_btn.setEnabled(True)
        self.task_running = True
        self.processes = []
        self.successful_files = []  # 记录成功下载文件的完整路径

        for _ in range(min(self.max_parallel, len(self.url_queue))):
            self.start_next_process()

    def start_next_process(self):
        if self.stop_flag or not self.url_queue:
            if not self.url_queue and not self.processes:
                self.finish_download()
            return

        url = self.url_queue.pop(0)
        out_dir = self.dir_edit.text().strip()

        # 获取该 URL 对应的 cookie 文件
        cookie_file = self.get_cookie_for_url(url)
        if cookie_file:
            self.log(f"为 {url} 匹配到 Cookie: {os.path.basename(cookie_file)}")
        else:
            self.log(f"未找到匹配的 Cookie，将不使用 Cookie 下载: {url}")

        proc = QProcess(self)
        proc.setProcessChannelMode(QProcess.MergedChannels)

        # 获取当前工具的可执行文件路径
        if self.current_tool == "you-get":
            executable = self.youget_path
        else:
            executable = self.ytdlp_path
        if not executable:
            self.log(f"错误: 无法找到 {self.current_tool} 引擎")
            self.fail_count += 1
            self.start_next_process()
            return

        # ===== 智能匹配自定义请求头 =====
        custom_headers_text = self.settings.value("custom_headers", "").strip()
        header_args = []
        if custom_headers_text:
            matched_lines = self.filter_headers_for_url(custom_headers_text, url)
            for line in matched_lines:
                if self.current_tool == "yt-dlp":
                    header_args.extend(["--add-header", line])
                elif self.current_tool == "you-get":
                    header_args.extend(["-H", line])
            if header_args:
                self.log(f"已为当前任务注入 {len(header_args) // 2} 条自定义请求头")
            else:
                self.log("当前任务无匹配的自定义请求头")

        # 构建参数
        if self.current_tool == "you-get":
            args = []
            if cookie_file and os.path.isfile(cookie_file):
                args += ["--cookie", cookie_file]
            
            args += header_args
            
            args += ["-o", out_dir, url]
        else:  # yt-dlp
            args = []
            if cookie_file and os.path.isfile(cookie_file):
                args += ["--cookies", cookie_file]
            
            args += header_args

            args += ["--print", "after_move:filepath"]
            
            args += ["-P", out_dir, url]

        proc.finished.connect(lambda exit_code, exit_status, p=proc: self.on_process_finished(p, exit_code, exit_status))
        proc.readyReadStandardOutput.connect(lambda p=proc: self.read_output(p))

        self.processes.append(proc)
        self.log(f"启动下载 [{self.current_tool}]: {url}")
        proc.start(executable, args)

    def read_output(self, proc):
        data = proc.readAllStandardOutput()
        if data:
            text = data.data().decode(errors='replace').strip()
            if text:
                self.log(f"[输出] {text}")
                
                if self.current_tool == "yt-dlp":
                    for line in text.splitlines():
                        line = line.strip()
                        if (":" in line and ("\\" in line or "/" in line)) or (line.startswith("/")):
                            if not os.path.isabs(line):
                                line = os.path.join(self.dir_edit.text().strip(), line)
                            if line not in self.successful_files:
                                self.successful_files.append(line)
                                self.log(f"检测到文件路径: {line}")
                # ==========================================

    def on_process_finished(self, proc, exit_code, exit_status):
        # 获取 URL（命令参数的最后一个）
        args = proc.arguments()
        url = args[-1] if args else "未知"
        if exit_status == QProcess.NormalExit and exit_code == 0:
            self.success_count += 1
            self.log(f"✔ 下载成功: {url}")
        else:
            self.fail_count += 1
            err_output = proc.readAllStandardOutput().data().decode(errors='replace')
            reason = "未知错误"
            if "cookie" in err_output.lower():
                reason = "Cookie 文件错误或已过期"
            elif "404" in err_output:
                reason = "视频不存在 (404)"
            elif "403" in err_output:
                reason = "访问被拒绝 (403)，可能需要有效的 Cookie"
            elif "timeout" in err_output.lower():
                reason = "连接超时"
            elif "unsupported" in err_output.lower():
                reason = "不支持的网站或格式"
            else:
                lines = err_output.splitlines()
                if lines:
                    reason = lines[-1][:80]
            self.log(f"✘ 下载失败: {url} 原因: {reason}")

        if proc in self.processes:
            self.processes.remove(proc)
        proc.deleteLater()

        if not self.stop_flag and self.url_queue:
            self.start_next_process()
        elif not self.processes:
            self.finish_download()

    def finish_download(self):
        self.task_running = False
        self.start_btn.setEnabled(self.is_current_tool_available())
        self.stop_btn.setEnabled(False)

        # === 需求五：分行显示下载文件的完整目录+文件名 ===
        summary_lines = [f"下载完毕！成功: {self.success_count}，失败: {self.fail_count}，总计: {self.total_tasks}"]
        if hasattr(self, 'successful_files') and self.successful_files:
            summary_lines.append("成功下载的文件:")
            summary_lines.extend(self.successful_files)
        else:
            summary_lines.append(f"下载目录: {self.dir_edit.text().strip()}")
        
        summary = "\n".join(summary_lines)
        self.log(summary)

        # === 需求四：弹窗增加打开功能 ===
        msg_box = QMessageBox(self)
        msg_box.setWindowTitle("批量下载完成")
        msg_box.setText(f"下载完毕！成功: {self.success_count}，失败: {self.fail_count}，总计: {self.total_tasks}")
        
        if hasattr(self, 'successful_files') and self.successful_files:
            msg_box.setDetailedText("成功文件:\n" + "\n".join(self.successful_files))
        
        open_btn = msg_box.addButton("打开下载目录", QMessageBox.ActionRole)
        ok_btn = msg_box.addButton("OK", QMessageBox.AcceptRole)
        msg_box.exec_()
        
        if msg_box.clickedButton() == open_btn:
            try:
                os.startfile(self.dir_edit.text().strip())
            except Exception as e:
                QMessageBox.warning(self, "错误", f"无法打开下载目录：{e}")


