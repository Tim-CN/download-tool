            ("爱奇艺 (iqiyi.com)", "iqiyi.com"),
            ("抖音 (douyin.com)", "douyin.com"),
            ("快手 (kuaishou.com)", "kuaishou.com"),
            ("西瓜视频 (ixigua.com)", "ixigua.com"),
            ("微博 (weibo.com)", "weibo.com"),
            ("知乎 (zhihu.com)", "zhihu.com"),
            ("微博国际版 (weibo.intl)", "weibo.intl"),
            ("Twitter (twitter.com)", "twitter.com"),
            ("Facebook (facebook.com)", "facebook.com"),
            ("Instagram (instagram.com)", "instagram.com"),
            ("Twitch (twitch.tv)", "twitch.tv"),
            ("Reddit (reddit.com)", "reddit.com"),
            ("Pinterest (pinterest.com)", "pinterest.com"),
            ("VK (vk.com)", "vk.com"),
            ("Vimeo (vimeo.com)", "vimeo.com"),
            ("Dailymotion (dailymotion.com)", "dailymotion.com"),
            ("SoundCloud (soundcloud.com)", "soundcloud.com"),
            ("Spotify (spotify.com)", "spotify.com"),
            ("Tumblr (tumblr.com)", "tumblr.com"),
            ("Vine (vine.co)", "vine.co"),
            ("Periscope (periscope.tv)", "periscope.tv"),
            ("Vidme (vid.me)", "vid.me"),
            ("其他 (手动输入)", "")
        ]

    def refresh_list(self):
        """刷新列表，显示 cookies_storage_dir 下所有 .txt 文件"""
        self.cookie_list.clear()
        if not os.path.exists(self.cookies_storage_dir):
            return
        for filename in os.listdir(self.cookies_storage_dir):
            if filename.endswith(".txt"):
                filepath = os.path.join(self.cookies_storage_dir, filename)
                domain = filename[:-4]  # 去掉 .txt
                size = os.path.getsize(filepath)
                item_text = f"{domain}  ({size} 字节)"
                item = QListWidgetItem(item_text)
                item.setData(Qt.UserRole, filepath)   # 存储完整路径
                self.cookie_list.addItem(item)

    def add_cookie(self):
        """导入新的 Cookie 文件"""
        # 选择 cookie 文件
        file_path, _ = QFileDialog.getOpenFileName(
            self, "选择 Cookie 文件", "", "文本文件 (*.txt);;所有文件 (*)"
        )
        if not file_path:
            return

        # 获取平台域名
        dialog = QDialog(self)
        dialog.setWindowTitle("选择平台")
        dialog.resize(400, 200)
        dlg_layout = QVBoxLayout(dialog)

        dlg_layout.addWidget(QLabel("请选择或输入平台域名 (例如 bilibili.com)："))

        combo = QComboBox()
        for display_name, domain in self.platforms:
            combo.addItem(display_name, domain)
        dlg_layout.addWidget(combo)

        manual_edit = QLineEdit()
        manual_edit.setPlaceholderText("或手动输入域名 (如 www.example.com)")
        dlg_layout.addWidget(manual_edit)

        def on_combo_changed(index):
            domain = combo.itemData(index)
            if domain and domain != "":
                manual_edit.setText(domain)
        combo.currentIndexChanged.connect(on_combo_changed)

        buttons = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        buttons.accepted.connect(dialog.accept)
        buttons.rejected.connect(dialog.reject)
        dlg_layout.addWidget(buttons)

        if dialog.exec_() != QDialog.Accepted:
            return

        domain = manual_edit.text().strip()
        if not domain:
            QMessageBox.warning(self, "错误", "平台域名不能为空")
            return

        # 规范域名：去除 http:// 等前缀，去除末尾斜杠
        domain = domain.lower().replace("http://", "").replace("https://", "").split("/")[0]

        # 目标文件名
        target_filename = f"{domain}.txt"
        target_path = os.path.join(self.cookies_storage_dir, target_filename)

        # 如果文件已存在，询问是否覆盖
        if os.path.exists(target_path):
            reply = QMessageBox.question(
                self, "文件已存在",
                f"平台 {domain} 的 Cookie 文件已存在，是否覆盖？",
                QMessageBox.Yes | QMessageBox.No
            )
            if reply != QMessageBox.Yes:
                return

        # 复制文件
        try:
            shutil.copy2(file_path, target_path)
            self.refresh_list()
            QMessageBox.information(self, "成功", f"Cookie 已添加至平台：{domain}")
            # 通知主窗口刷新状态
            if self.parent_widget:
                self.parent_widget.on_cookie_changed()
        except Exception as e:
            QMessageBox.critical(self, "错误", f"复制文件失败：{e}")

    def delete_cookie(self):
        """删除选中的 Cookie"""
        current = self.cookie_list.currentItem()
        if not current:
            QMessageBox.information(self, "提示", "请先选中要删除的项目")
            return
        filepath = current.data(Qt.UserRole)
        domain = os.path.basename(filepath)[:-4]
        reply = QMessageBox.question(
            self, "确认删除",
            f"确定要删除平台 {domain} 的 Cookie 吗？",
            QMessageBox.Yes | QMessageBox.No
        )
        if reply == QMessageBox.Yes:
            try:
                os.remove(filepath)
                self.refresh_list()
                if self.parent_widget:
                    self.parent_widget.on_cookie_changed()
            except Exception as e:
                QMessageBox.critical(self, "错误", f"删除失败：{e}")

    def open_storage_folder(self):
        """打开存储文件夹"""
        os.startfile(self.cookies_storage_dir)


