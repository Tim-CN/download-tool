    # ==================== 工具相关（内置引擎优先） ====================
    def get_engine_path(self, tool_name):
        """获取引擎可执行文件路径，优先返回内置路径，否则返回 None"""
        if sys.platform == "win32":
            if tool_name == "yt-dlp":
                # 尝试多个可能的文件名
                candidates = [f"{tool_name}.exe", f"{tool_name}_arm64.exe", "yt-dlp_arm64.exe"]
            else:
                candidates = [f"{tool_name}.exe"]
        else:
            candidates = [tool_name]
        
        for exe_name in candidates:
            builtin_path = os.path.join(self.engines_dir, exe_name)
            if os.path.isfile(builtin_path) and os.access(builtin_path, os.X_OK):
                return builtin_path
        return None

    def check_tool(self, tool_name):
        """检查指定工具是否可用，返回 (是否可用, 可执行文件路径)"""
        # 1. 检查内置路径
        engine_path = self.get_engine_path(tool_name)
        if engine_path:
            # 验证一下能否运行 --version（可选，确保不是损坏文件）
            try:
                subprocess.run([engine_path, "--version"], capture_output=True, check=True)
                return True, engine_path
            except (subprocess.SubprocessError, FileNotFoundError):
                pass  # 内置文件无效，继续尝试系统 PATH
        # 2. 回退到系统 PATH
        try:
            if tool_name == "you-get":
                subprocess.run(["you-get", "--version"], capture_output=True, check=True)
                return True, "you-get"
            elif tool_name == "yt-dlp":
                subprocess.run(["yt-dlp", "--version"], capture_output=True, check=True)
                return True, "yt-dlp"
        except (subprocess.SubprocessError, FileNotFoundError):
            pass
        return False, None

