if __name__ == "__main__":
    app = QApplication(sys.argv)
    app.setStyle("Fusion")

    # ===== 启动前检查用户协议 =====
    settings = QSettings("YouGetBatchTool", "Settings")
    skip_agreement = settings.value("agreement_skip", False, type=bool)

    if not skip_agreement:
        dlg = AgreementDialog()
        result = dlg.exec_()
        if result != QDialog.Accepted or not dlg.agreed:
            sys.exit(0)
        if dlg.no_ask_again:
            settings.setValue("agreement_skip", True)
    # ================================

    window = YouGetBatchDownloader()
    window.show()
    sys.exit(app.exec_())
