class PlatformCookieManager(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.parent_widget = parent
        self.setWindowTitle("平台 Cookie 管理")
        self.resize(600, 400)

        # 存储 Cookie 的目录 (AppData/you-get batch download tool/cookies)
        appdata_dir = os.path.join(os.getenv("APPDATA", os.path.expanduser("~")),
                                    "you-get batch download tool")
        self.cookies_storage_dir = os.path.join(appdata_dir, "cookies")
        os.makedirs(self.cookies_storage_dir, exist_ok=True)

        # 预定义平台列表（域名 -> 显示名称）
        self.platforms = self._get_platform_list()

        layout = QVBoxLayout(self)

        # 说明标签
        info_label = QLabel("在此管理各视频平台的 Cookie 文件。程序将根据下载链接自动匹配对应平台的 Cookie。")
        info_label.setWordWrap(True)
        info_label.setStyleSheet("color: #666; margin-bottom: 8px;")
        layout.addWidget(info_label)

        # 列表显示已有 Cookie
        self.cookie_list = QListWidget()
        self.cookie_list.setAlternatingRowColors(True)
        layout.addWidget(self.cookie_list)

        # 按钮区域
        btn_layout = QHBoxLayout()
        add_btn = QPushButton("➕ 添加 Cookie")
        add_btn.clicked.connect(self.add_cookie)
        delete_btn = QPushButton("🗑 删除选中")
        delete_btn.clicked.connect(self.delete_cookie)
        open_folder_btn = QPushButton("📁 打开存储文件夹")
        open_folder_btn.clicked.connect(self.open_storage_folder)
        btn_layout.addWidget(add_btn)
        btn_layout.addWidget(delete_btn)
        btn_layout.addWidget(open_folder_btn)
        btn_layout.addStretch()
        layout.addLayout(btn_layout)

        # 确认关闭按钮
        button_box = QDialogButtonBox(QDialogButtonBox.Close)
        button_box.rejected.connect(self.accept)
        layout.addWidget(button_box)

        self.refresh_list()

    def _get_platform_list(self):
        """返回 (显示名称, 域名) 列表，用于添加时快速选择"""
        return [
            ("请选择", ""),
            ("哔哩哔哩 (bilibili.com)", "bilibili.com"),
            ("YouTube (youtube.com)", "youtube.com"),
            ("抖音国际版 (tiktok.com)", "tiktok.com"),
