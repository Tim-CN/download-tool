    def one_click_download_cookie(self):
        """一键下载 Cookie 并自动添加到管理器"""
        domain = self.quick_platform_combo.currentData()
        platform_name = self.quick_platform_combo.currentText()
        if not domain:
            QMessageBox.warning(self, "提示", "请选择有效的平台")
            return

        # 确认登录对话框
        confirm_dialog = QDialog(self)
        confirm_dialog.setWindowTitle("登录确认")
        confirm_dialog.resize(500, 200)
        cf_layout = QVBoxLayout(confirm_dialog)

        cf_layout.addWidget(QLabel(
            f"<p style='color:red; font-weight:bold;'>"
            f"请确认您已经在默认浏览器中登录了「{platform_name}」({domain})，然后继续。</p>"
        ))

        # 倒计时
        countdown_label = QLabel("5s")
        countdown_label.setAlignment(Qt.AlignCenter)
        countdown_label.setStyleSheet("font-size: 24px; font-weight: bold; color: #d32f2f;")
        cf_layout.addWidget(countdown_label)

        btn_box = QDialogButtonBox()
        ok_btn = btn_box.addButton("确定", QDialogButtonBox.AcceptRole)
        ok_btn.setEnabled(False)
        cancel_btn = btn_box.addButton("取消", QDialogButtonBox.RejectRole)
        btn_box.rejected.connect(confirm_dialog.reject)
        btn_box.accepted.connect(confirm_dialog.accept)
        cf_layout.addWidget(btn_box)

        # 倒计时逻辑
        countdown_value = 5
        timer = QTimer(confirm_dialog)

        def update_countdown():
            nonlocal countdown_value
            countdown_value -= 1
            if countdown_value <= 0:
                timer.stop()
                countdown_label.setText("")
                countdown_label.setVisible(False)
                ok_btn.setEnabled(True)
            else:
                countdown_label.setText(f"{countdown_value}s")
        timer.timeout.connect(update_countdown)
        timer.start(1000)

        if confirm_dialog.exec_() != QDialog.Accepted:
            timer.stop()
            return

        timer.stop()

        # 后台导出
        download_dir = os.path.join(os.path.expanduser("~"), "Downloads", "you-get batch download tool")
        os.makedirs(download_dir, exist_ok=True)

        progress_dialog = QDialog(self)
        progress_dialog.setWindowTitle("正在导出 Cookie")
        progress_dialog.resize(450, 150)
        pg_layout = QVBoxLayout(progress_dialog)
        progress_label = QLabel("正在从浏览器中提取 Cookie，请稍候...")
        pg_layout.addWidget(progress_label)
        progress_bar = QProgressBar()
        progress_bar.setRange(0, 0)
        pg_layout.addWidget(progress_bar)
        progress_dialog.setModal(True)
        progress_dialog.show()

        self.cookie_worker = CookieDownloadWorker(domain, download_dir)
        self.cookie_worker.log_signal.connect(lambda msg: progress_label.setText(msg))

        def on_finished(success, result):
            progress_dialog.close()
            if success:
                # 将导出的 cookie 添加到管理器
                appdata_dir = os.path.join(os.getenv("APPDATA", os.path.expanduser("~")),
                                            "you-get batch download tool")
                cookies_dir = os.path.join(appdata_dir, "cookies")
                os.makedirs(cookies_dir, exist_ok=True)
                target_path = os.path.join(cookies_dir, f"{domain}.txt")
                shutil.copy2(result, target_path)
                QMessageBox.information(self, "成功",
                                        f"Cookie 已成功导出并添加到平台「{platform_name}」\n"
                                        f"存储路径：{target_path}")
                if self.parent_widget:
                    self.parent_widget.on_cookie_changed()
            else:
                QMessageBox.warning(self, "失败", f"导出 Cookie 失败：\n{result}\n\n"
                                                "请确保：\n"
                                                "1. 已在浏览器中登录该平台\n"
                                                "2. 使用的浏览器为 Chrome、Firefox、Edge 等主流浏览器")

        self.cookie_worker.finished_signal.connect(on_finished)
        self.cookie_worker.start()

    def load_settings(self):
        default_log_dir = os.path.join(os.getenv("APPDATA", os.path.expanduser("~")),
                                       "you-get batch download tool")
        self.log_dir_edit.setText(self.settings.value("log_dir", default_log_dir))

