    def _build_error_page(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.addStretch()

        icon = QLabel("⚠")
        icon.setAlignment(Qt.AlignCenter)
        icon.setStyleSheet("font-size: 42px; color: #d32f2f;")
        layout.addWidget(icon)

        msg = QLabel(
            "<div style='font-size:14px;color:#333;text-align:center;'>"
            "<b>本应用需要连接互联网使用</b><br><br>"
            "无法获取在线用户协议内容，请检查网络连接后重试。"
            "</div>"
        )
        msg.setAlignment(Qt.AlignCenter)
        msg.setWordWrap(True)
        layout.addWidget(msg)

        self.error_detail_label = QLabel("")
        self.error_detail_label.setAlignment(Qt.AlignCenter)
        self.error_detail_label.setWordWrap(True)
        self.error_detail_label.setStyleSheet("color: #888; font-size: 12px;")
        layout.addWidget(self.error_detail_label)

        layout.addSpacing(16)

        btn_row = QHBoxLayout()
        btn_row.addStretch()

        retry_btn = QPushButton("重新连接")
        retry_btn.setMinimumWidth(120)
        retry_btn.setMinimumHeight(32)
        retry_btn.clicked.connect(self._start_load)
        btn_row.addWidget(retry_btn)

        exit_btn = QPushButton("退出应用")
        exit_btn.setMinimumWidth(120)
        exit_btn.setMinimumHeight(32)
        exit_btn.clicked.connect(self._on_exit_app)
        btn_row.addWidget(exit_btn)

        btn_row.addStretch()
        layout.addLayout(btn_row)

        layout.addStretch()
        return page

    # ---------- 加载逻辑 ----------
    def _start_load(self):
        # 切换到加载页
        self.stack.setCurrentWidget(self._loading_page)

        # 若已有线程在跑，先清理
        if self._load_thread is not None and self._load_thread.isRunning():
            return

        self._load_thread = AgreementLoadThread(self.EMBED_URL, self)
        self._load_thread.finished_signal.connect(self._on_load_finished)
        self._load_thread.start()

    def _on_load_finished(self, success, payload):
        if success:
            self._show_content(payload)
        else:
            self._show_error(payload)

    def _show_content(self, html):
        self.text_edit.setHtml(html)
        # 重置滚动与解锁状态
        self._has_reached_bottom = False
        self.agree_check.setChecked(False)
        self.agree_check.setEnabled(False)
        self.agree_check.setStyleSheet("color: #999; font-size: 13px;")
        self.enter_btn.setEnabled(False)

        self.stack.setCurrentWidget(self._content_page)

        # 内容短于可视区域时（无滚动条），直接解锁
        QTimer.singleShot(250, self._check_if_content_short)

    def _show_error(self, detail):
        self.error_detail_label.setText(f"错误详情：{detail}")
        self.stack.setCurrentWidget(self._error_page)

    def _on_exit_app(self):
        QApplication.quit()

    # ---------- 滚动解锁 ----------
    def _on_scroll(self, value):
        if self._has_reached_bottom:
            return
        bar = self.text_edit.verticalScrollBar()
        if bar.value() >= bar.maximum() - 5:
            self._has_reached_bottom = True
            self.agree_check.setEnabled(True)
            self.agree_check.setStyleSheet(
                "color: #1f2328; font-size: 13px; font-weight: 600;"
            )

    def _check_if_content_short(self):
        bar = self.text_edit.verticalScrollBar()
        if bar.maximum() == 0:
            self._has_reached_bottom = True
            self.agree_check.setEnabled(True)
            self.agree_check.setStyleSheet(
                "color: #1f2328; font-size: 13px; font-weight: 600;"
            )

    def _on_agree_toggle(self, state):
        self.enter_btn.setEnabled(self.agree_check.isChecked())

    def _on_enter(self):
        if not self.agree_check.isChecked():
            return
        self._agreed = True
        self._no_ask_again = self.no_ask_check.isChecked()
        self.accept()

    # ---------- 屏蔽关闭 ----------
    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape:
            return
        super().keyPressEvent(event)

    def closeEvent(self, event):
        if self._agreed:
            event.accept()
        else:
            event.ignore()

    @property
    def agreed(self):
        return self._agreed

    @property
    def no_ask_again(self):
        return self._no_ask_again

